# Optional. The app runs in deterministic offline mode when no key is set.
# OpenAI-compatible (OpenAI, Azure OpenAI, or a local proxy).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Anthropic (used when OPENAI_API_KEY is empty and this is set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional overrides
FINAGENT_DATA_DIR=
FINAGENT_MAX_TOOL_ROUNDS=6
