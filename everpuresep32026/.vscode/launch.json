{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Everpure Finance Agent (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py", "--server.headless", "true", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "jinja": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Everpure Finance Agent (Gradio)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/gradio_app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Ask a sample question",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ask.py",
      "args": ["What was the revenue in Q1 FY2026?"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
